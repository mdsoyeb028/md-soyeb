{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User account document",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "Report": {
      "title": "Report",
      "description": "User generated business, SEO, export, or social intelligence report",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": {
          "type": "string",
          "enum": ["seo", "social", "export", "business", "assistant"]
        },
        "title": { "type": "string", "maxLength": 500 },
        "input": { "type": "object" },
        "context": { "type": "string", "maxLength": 2000 },
        "result": { "type": "object" },
        "content": { "type": "string", "maxLength": 50000 },
        "summary": { "type": "string", "maxLength": 1000 },
        "category": { "type": "string", "maxLength": 100 },
        "tags": { "type": "array" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["id", "userId", "type", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "Private profile document for each user"
    },
    "/users/{userId}/reports/{reportId}": {
      "schema": "Report",
      "description": "Private subcollection of reports belonging strictly to the user"
    }
  }
}
