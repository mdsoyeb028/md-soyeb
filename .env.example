# GEMINI_API_KEY: Required for Gemini AI API calls (Primary Provider: Gemini -> Groq -> OpenRouter).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Optional secondary AI provider key (high-speed free-tier models such as Llama 3.3 70B & Llama 3.1 8B).
GROQ_API_KEY="MY_GROQ_API_KEY"

# OPENROUTER_API_KEY: Optional tertiary AI fallback provider key for OpenRouter free models.
OPENROUTER_API_KEY="MY_OPENROUTER_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT: Required JSON string for Firebase Admin SDK token verification & server Firestore access.
FIREBASE_SERVICE_ACCOUNT="{\"type\":\"service_account\",\"project_id\":\"...\",\"private_key\":\"...\",\"client_email\":\"...\"}"

# UPSTASH_REDIS_REST_URL & UPSTASH_REDIS_REST_TOKEN: Upstash Redis connection parameters for persistent atomic usage tracking.
UPSTASH_REDIS_REST_URL="https://...upstash.io"
UPSTASH_REDIS_REST_TOKEN="MY_UPSTASH_REDIS_TOKEN"

# RAZORPAY CONFIGURATION (Prepaid India & Global Payments)
# RAZORPAY_KEY_ID: Razorpay Key ID (e.g. rzp_test_... or rzp_live_...)
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# RAZORPAY_KEY_SECRET: Razorpay Key Secret for Orders creation and Checkout signature verification
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Dashboard for webhook signature verification
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# RESEND CONFIGURATION (Transactional Email Dispatch)
# RESEND_API_KEY: Resend API Key for verified email dispatches (e.g. re_123456789)
RESEND_API_KEY="re_YOUR_RESEND_API_KEY"

# RESEND_FROM_EMAIL: Verified sender email address (e.g. notifications@yourdomain.com or onboarding@resend.dev)
RESEND_FROM_EMAIL="onboarding@resend.dev"
