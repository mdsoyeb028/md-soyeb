rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.uid == userId && (data.email is string || data.email == null);
    }

    function isValidReport(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.type in ['seo', 'social', 'export', 'business', 'assistant', 'ai-assistant'] &&
        data.title is string && data.title.size() <= 500;
    }

    // User profile document
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow delete: if isOwner(userId);

      // Private reports subcollection
      match /reports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReport(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidReport(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
