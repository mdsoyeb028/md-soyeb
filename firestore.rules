rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUser(data, userId) {
      return data.uid == userId && (data.email is string || data.email == null);
    }

    function isValidReport(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.type in ['seo', 'social', 'export', 'business', 'assistant', 'ai-assistant', 'traffic'] &&
        data.title is string && data.title.size() <= 500;
    }

    function isValidAgent(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        (data.name is string || data.businessName is string) &&
        data.industry is string;
    }

    function isValidTask(data, userId) {
      return data.userId == userId &&
        data.id is string && data.id.size() <= 128 &&
        data.title is string && data.title.size() <= 300 &&
        data.status in ['TODO', 'IN PROGRESS', 'PREPARED BY AI', 'WAITING FOR APPROVAL', 'EXECUTED', 'COMPLETED', 'FAILED'];
    }

    function isValidPublicAgent(data) {
      return data.isPublic == true &&
        data.id is string && data.id.size() <= 128 &&
        (data.name is string || data.businessName is string) &&
        data.industry is string;
    }

    // Controlled Public Agents collection (only explicitly approved public info displayed)
    match /public_agents/{agentId} {
      allow get: if resource.data.isPublic == true;
      allow list: if false; // prevent directory scraping
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid && isValidPublicAgent(request.resource.data);
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Controlled Public Customer Agents collection for website widgets (strictly approved public branding)
    match /public_customer_agents/{agentId} {
      allow get: if resource.data.enabled == true;
      allow list: if false; // prevent directory scraping
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid && request.resource.data.userId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // User profile document
    match /users/{userId} {
      allow get, list: if isOwner(userId);
      // Users cannot write or modify the 'plan' field themselves (managed strictly server-side / Admin SDK)
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId) &&
        !('plan' in request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data, userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['plan']);
      allow delete: if isOwner(userId);

      // Private reports subcollection
      match /reports/{reportId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidReport(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidReport(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }

      // Private custom AI business agents subcollection
      match /agents/{agentId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidAgent(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidAgent(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);

        // Nested subcollections per agent for complete data isolation
        match /conversations/{conversationId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /tasks/{taskId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidTask(request.resource.data, userId);
          allow update: if isOwner(userId) && isValidTask(request.resource.data, userId) &&
            request.resource.data.userId == resource.data.userId;
          allow delete: if isOwner(userId);
        }

        match /reports/{reportId} {
          allow get, list: if isOwner(userId);
          allow create: if isOwner(userId) && isValidReport(request.resource.data, userId);
          allow update: if isOwner(userId) && isValidReport(request.resource.data, userId) &&
            request.resource.data.userId == resource.data.userId;
          allow delete: if isOwner(userId);
        }

        match /documents/{documentId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        // AI Customer Agent subcollections for the business owner
        match /customerAgent/{docId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /customerLeads/{leadId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /customerAppointments/{appointmentId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /customerConversations/{conversationId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /customerKnowledge/{knowledgeId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /customerAutomations/{automationId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }

        match /customerIntegrations/{integrationId} {
          allow get, list, create, update, delete: if isOwner(userId);
        }
      }

      // Private tasks & external action approvals subcollection (top-level)
      match /tasks/{taskId} {
        allow get, list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidTask(request.resource.data, userId);
        allow update: if isOwner(userId) && isValidTask(request.resource.data, userId) &&
          request.resource.data.userId == resource.data.userId;
        allow delete: if isOwner(userId);
      }
    }
  }
}
